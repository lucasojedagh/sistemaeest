# ---------------------------------------------------------------------------
# Configuracion del frontend (Vite). Copia este archivo a `.env` y ajusta.
#
# `.env` NO pisa a `frontend/.env.example`: Vite lee `.env`, `.env.local`,
# `.env.production`, etc. Para desarrollo local normalmente NO hace falta
# crear ningun archivo (ver modo 1).
#
# IMPORTANTE: VITE_API_BASE se "quema" en el bundle EN TIEMPO DE BUILD
# (`npm run build`), no en tiempo de ejecucion. Cambiarla exige recompilar
# el frontend y re-publicar el `dist`. En Docker, el valor se pasa como
# `build.args` del servicio frontend (docker-compose.yml), no como `environment`.
# ---------------------------------------------------------------------------

# --- Modo 1: desarrollo local (el caso de todos los dias) -------------------
# Dejá esta variable COMENTADA (o sin archivo .env). El frontend toma el
# default interno http://localhost:8000/api, o sea el `php artisan serve`
# de Laravel en la misma máquina.
# VITE_API_BASE=

# --- Modo 2: red de la institucion, todo en el mismo origen (RECOMENDADO) ---
# Enrutá "/api" al backend desde el servidor web que sirve la pagina
# (nginx del docker-compose, o el apache/nginx institucional). El navegador
# resuelve "/api" contra el origen que sirve el sitio, asi que el mismo build
# funciona en http://192.168.1.20, en http://sistemas.escuela.edu.ar o en
# https://escuela.edu.ar sin recompilar, y no hay CORS que configurar.
# VITE_API_BASE=/api

# --- Modo 3: backend en otro host ------------------------------------------
# Cuando la API vive en un servidor/dominio propio. Tiene que ser URL absoluta
# (incluido el "/api") y ese backend debe permitir el origen del frontend en
# CORS (backend/config/cors.php -> allowed_origins).
# VITE_API_BASE=https://api.ejemplo.edu.ar/api

# Nota: las URLs relativas siempre empiezan con "/". Un valor tipo "api" (sin
# barra) se normaliza a "/api"; una barra final sobrando se ignora.
