APP_NAME="Sistema ENRO (Docker)"
# Produccion: con APP_DEBUG=true cualquier error 500 devuelve la traza completa
# (consulta SQL y valores incluidos) en la pantalla del preceptor. Para ver la
# traza al debuggear en el server, cambiar temporalmente a true y reiniciar:
#   docker compose restart backend
APP_ENV=production
APP_DEBUG=false
# En el server este origen tiene que ser el real con el que entran los
# preceptores (http://192.168.1.20 o http://sistema.escuela.edu.ar); sirve para
# los CORS de desarrollo y para armar links absolutos.
APP_URL=http://localhost:8000
# VACIA a proposito. La clave que estaba aqui se subio al remoto publico, o sea
# que no es secreta: cualquiera podria descifrar las cookies y los datos
# cifrados del server. scripts/iniciar.sh se niega a levantar sin clave propia.
# Generarla (una sola vez, y anotala: con otra key se leen mal los datos viejos).
# El --show imprime la clave sin escribirla; se pega en esta misma linea, porque
# compose pasa APP_KEY por env_file y eso le gana a lo que artisan escriba en
# backend/.env. Después: docker compose restart backend
#   docker compose exec backend php artisan key:generate --show
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sistema_escuela
DB_USERNAME=root
# Este valor NO se usa: docker-compose.yml lo pisa con DB_PASSWORD=${ENRO_DB_PASSWORD}
# para que la clave del backend y la del servicio mysql salgan del mismo lugar.
# La clave real del server se pone en el archivo .env de la raiz del repo.
DB_PASSWORD=root

CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Logs por dia (storage/logs/laravel-YYYY-MM-DD.log) y retencion de 30 dias.
# El default 'stack' del framework escribe todo en un unico laravel.log que no
# se corta nunca: en un server con 1200 alumnos termina ocupando el disco.
LOG_CHANNEL=daily
LOG_DAILY_DAYS=30

# En el server hay que cambiarlo por el origen REAL con el que entran los
# preceptores (ej. http://192.168.1.20 o http://sistema.escuela.edu.ar): este
# valor arma el link de "recuperar contraseña" que se envía por correo, además
# de habilitar el CORS en desarrollo. Si queda en localhost, el mail de recupero
# no abre del notebook de ningún otro. Con el nginx del compose en puerto 80
# alcanza la IP sin puerto; si se deja el 8000, poner http://<IP>:8000.
FRONTEND_URL=http://localhost:5173

# Correos de prueba: bandeja local en http://localhost:8025 (servicio mailpit)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
